<controls:SettingsPageBase x:Class="YcyzClass.Views.SettingPages.AboutSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="using:YcyzClass.Views.SettingPages"
      xmlns:controls="using:YcyzClass.Core.Abstractions.Controls"
      xmlns:ci="using:YcyzClass"
      xmlns:controls1="using:YcyzClass.Core.Controls"
      xmlns:models="using:YcyzClass.Models"
      xmlns:commands="http://ycyzclass.tech/schemas/xaml/core"
      xmlns:controls2="clr-namespace:YcyzClass.Controls"
      xmlns:ci2="http://ycyzclass.tech/schemas/xaml/core"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
      xmlns:controls3="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:AboutSettingsPage}">
    <controls:SettingsPageBase.Resources>
        <Grid Margin="16" x:Key="ThirdPartyLibs" Width="300" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="第三方库" Theme="{StaticResource SubtitleTextBlockStyle}" />
            <ListBox Grid.Row="1" Margin="0 6 0 0"
                     ItemsSource="{Binding ViewModel.ThirdPartyLibs}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:NuGetLicenseInfo}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                              Margin="0 4">
                            <controls1:FluentIcon Grid.Row="0" Grid.Column="0"
                                                  Glyph="&#xE07D;" VerticalAlignment="Center"
                                                  Margin="0 0 6 0" />
                             <TextBlock Grid.Row="0" Grid.Column="1"
                                        Text="{Binding PackageId}"
                                        VerticalAlignment="Center" FontSize="14"
                                        FontWeight="Bold" TextWrapping="Wrap" />
                            <WrapPanel Grid.Row="1" Grid.Column="1"
                                       VerticalAlignment="Center" 
                                       IsVisible="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}">
                                 <commands:NavHyperlink NavTarget="{Binding PackageProjectUrl}"
                                                        ToolTip.Tip="{Binding PackageProjectUrl}">
                                     网站…
                                 </commands:NavHyperlink>
                                 <commands:NavHyperlink NavTarget="{Binding LicenseUrl}"
                                                        ToolTip.Tip="{Binding LicenseUrl}">
                                     <TextBlock Text="{Binding License, StringFormat='许可证：{0}'}" />
                                 </commands:NavHyperlink>
                             </WrapPanel>
                         </Grid>
                     </DataTemplate>
                 </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid x:Key="OpenSourceLicense" Margin="16" MaxHeight="{Binding Height}"
              RowDefinitions="Auto,*,Auto">
            <TextBox Grid.Row="1" Margin="0 12 0 0"
                     Padding="8" Text="{Binding ViewModel.License, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" />
        </Grid>

        <Grid x:Key="DiagnosticInfoDialog" Margin="16" Height="400" Width="550" MaxHeight="{Binding Height}"
              RowDefinitions="Auto,*,Auto">
            <TextBox Grid.Row="1" Margin="0 12 0 0"
                     Padding="8" Text="{Binding ViewModel.DiagnosticInfo, Mode=OneWay}" IsReadOnly="True"
                     VerticalContentAlignment="Top"
                     FontFamily="Consolas" />
        </Grid>

    </controls:SettingsPageBase.Resources>
    <controls1:StickyScrollViewer CollapsedHeight="58">
        <controls1:StickyScrollViewer.HeaderContent>
            <Grid>
                <Panel MaxHeight="300" 
                       Opacity="{Binding $self.(ci2:StickyScrollViewer.HeaderFadingOpacity)}"
                       Background="Transparent">
                    <Panel.OpacityMask>
                        <LinearGradientBrush StartPoint="0%, 0%"
                                             EndPoint="0%, 100%">
                            <GradientStop Color="#ffffffff" Offset="0.0"/>
                            <GradientStop Color="#ffffffff" Offset="0.75"/>
                            <GradientStop Color="#00ffffff" Offset="0.92"/>
                        </LinearGradientBrush>
                    </Panel.OpacityMask>
                    <Border Background="#0d1111" />
                    <Panel MaxWidth="{StaticResource SettingsContainerWidth}">
                        <Panel.Styles>
                            <Style Selector="Panel">
                                <Style.Animations>
                                    <Animation Delay="0:0:0.25" Duration="0:0:0.2"
                                               FillMode="Both" Easing="0,0 0,1">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="0.0"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </KeyFrame>
                                    </Animation> 
                                </Style.Animations>
                            </Style>
                        </Panel.Styles>
                        <Border Width="{Binding $self.Bounds.Height}"
                                HorizontalAlignment="Left"
                                Margin="-150 -100 0 0">
                            <Border.Background>
                                <RadialGradientBrush Center="50%, 50%">
                                    <GradientStop Offset="0.2" Color="#ff0c0e1f"/>
                                    <GradientStop Offset="1" Color="#ff0d1111"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Width="{Binding $self.Bounds.Height}"
                                HorizontalAlignment="Right"
                                Margin="0 0 100 -50">
                            <Border.Background>
                                <RadialGradientBrush Center="50%, 50%">
                                    <GradientStop Offset="0.2" Color="#ff0c0e1f"/>
                                    <GradientStop Offset="1" Color="#ff0d1111"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                    </Panel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="6"
                                Margin="0 18 0 40"
                                PointerPressed="DebugBorder_OnPointerPressed">
                        <Border Width="72" Height="72" CornerRadius="20"
                                HorizontalAlignment="Center"
                                Background="#1b2130"
                                BorderBrush="#2b3346" BorderThickness="1">
                            <Image Source="/Assets/AppLogo.png" Width="52" Height="52"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Border>
                        <TextBlock Text="YcyzClass"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#ffffff"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Static local:AboutSettingsPage.DisplayVersion}"
                                   FontSize="12"
                                   Foreground="#9aa4b2"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="为禹城一中打造的课表与班级工位"
                                   FontSize="13"
                                   Foreground="#8b93a1"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Panel>
                <Border Margin="12 16 18 0"
                        MaxWidth="{StaticResource SettingsContainerWidth}">
                    <TextBlock FontWeight="Normal"
                               Text="关于 YcyzClass"
                               VerticalAlignment="Bottom"
                               Theme="{StaticResource TitleTextBlockStyle}"
                               Margin="0 8"/>
                </Border>
            </Grid>
        </controls1:StickyScrollViewer.HeaderContent>
        <StackPanel Classes="settings-container ">
            <controls3:SettingsExpander Header="YcyzClass"
                                        IsExpanded="True">
                <controls3:SettingsExpander.Footer>
                    <TextBlock Text="{x:Static local:AboutSettingsPage.DisplayVersion}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </controls3:SettingsExpander.Footer>
                <controls3:SettingsExpander.IconSource>
                    <controls3:ImageIconSource Source="/Assets/AppLogo.png"/>
                </controls3:SettingsExpander.IconSource>
                <controls3:SettingsExpanderItem Description="本项目基于 GNU General Public License v3.0 获得许可。">
                    <controls3:SettingsExpanderItem.Footer>
                        <WrapPanel Classes="animated-resize">
                            <WrapPanel.Styles>
                                <Style Selector="HyperlinkButton">
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="Margin" Value="2"/>
                                </Style>
                            </WrapPanel.Styles>
                            <HyperlinkButton Click="SettingsExpanderItemShowOssLicense_OnClick"
                                             CommandParameter="https://github.com/sizhenhualei/ycyzclass/blob/master/LICENSE.txt">
                                <TextBlock Text="开放源代码许可"/>
                            </HyperlinkButton>
                            <HyperlinkButton Click="ButtonPrivacy_OnClick">
                                <TextBlock Text="隐私政策"/>
                            </HyperlinkButton>
                        </WrapPanel>
                    </controls3:SettingsExpanderItem.Footer>
                    <StackPanel Spacing="6">
                        <TextBlock Background="Transparent" TextWrapping="Wrap">
                            <Run Text="Copyright (c) 2026-"/><Run Text="{Binding Year, Source={x:Static system:DateTime.Now}, Mode=OneWay}" /> 司振华蕾 x DeepSeekV4.1
                        </TextBlock>
                        <TextBlock Background="Transparent" TextWrapping="Wrap"
                                   FontSize="12"
                                   Opacity="0.6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="本作品基于 ClassIsland 二次开发（原作者 HelloWRC），非 ClassIsland 官方项目。" />
                    </StackPanel>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>

            <controls3:SettingsExpander Header="联系与反馈" IconSource="{commands:FluentIconSource &#xE3F6;}"
                                        IsExpanded="True">
                <controls3:SettingsExpanderItem
                    Content="邮箱：sizhenhualei@163.com"
                    Click="ButtonCopyEmail_OnClick"
                    ActionIconSource="{controls1:FluentIconSource &#xE8C8;} "
                    IsClickEnabled="True"/>
                <controls3:SettingsExpanderItem
                    Content="QQ：1150556671"
                    Click="ButtonCopyQQ_OnClick"
                    ActionIconSource="{controls1:FluentIconSource &#xE8C8;} "
                    IsClickEnabled="True"/>
                <controls3:SettingsExpanderItem 
                    Click="ButtonDiagnosticInfo_OnClick"
                    Content="查看诊断信息"
                    IsClickEnabled="True"/>
                <controls3:SettingsExpanderItem
                    Click="UriNavigationCommands_OnClick"
                    CommandParameter="https://github.com/sizhenhualei/ycyzclass"
                    Content="GitHub 仓库"
                    ActionIconSource="{controls1:FluentIconSource &#xEC2E;} "
                    IsClickEnabled="True"/>
                <controls3:SettingsExpanderItem>
                    <TextBlock LineHeight="22" FontSize="12" TextWrapping="Wrap"
                               Opacity="0.7"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="反馈问题时请附上“查看诊断信息”中的内容，便于更快定位问题。" />
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>

            <controls3:SettingsExpander Header="鸣谢" IconSource="{commands:FluentIconSource &#xE971;}"
                                        IsExpanded="True">
                <controls3:SettingsExpanderItem 
                    Content="第三方库"
                    Click="ButtonThirdPartyLibs_OnClick"
                    IsClickEnabled="True"/>
                <controls3:SettingsExpanderItem>
                    <TextBlock LineHeight="30" Margin="0 0 0 0" FontSize="14" TextWrapping="Wrap">
                        本项目受到
                        <HyperlinkButton Click="Hyperlink2_OnClick">DuguSand/class_form</HyperlinkButton>
                        的启发而开发。<LineBreak/>
                        界面主题和部分控件使用了 FluentAvalonia 框架。<LineBreak/>
                        应用字体使用了华为出品的 HarmonyOS Sans。<LineBreak/>
                        感谢协助本应用测试的同学。<LineBreak/>
                        感谢<commands:NavHyperlink NavTarget="https://forum.smart-teach.cn/">智教联盟</commands:NavHyperlink>提供的社区支持。<LineBreak/>
                        天气数据来源于小米天气。<LineBreak/>
                        部分图像资源（/Assets/HoYoStickers/*）来自米游社和 Bilibili 装扮表情包，版权归 miHoYo 所有。<LineBreak/>
                        感谢其他使用的第三方库和贡献成员，详见第三方库列表。
                    </TextBlock>
                </controls3:SettingsExpanderItem>

            </controls3:SettingsExpander>

            <controls3:SettingsExpander Header="回声洞" IconSource="{commands:FluentIconSource &#xE55F;}">
                <controls3:SettingsExpanderItem 
                    IsClickEnabled="True"
                    Click="Sayings_OnMouseLeftButtonDown">
                    <StackPanel>
                        <controls2:TypingControl
                                 Text="{Binding ViewModel.Sayings, Mode=OneWay}"
                                 IsBusy="{Binding ViewModel.IsSayingBusy, Mode=OneWayToSource}"/>
                    </StackPanel>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>
            
            <TextBlock Text="谨以此应用，献给现在或曾经陪伴着我的同学们。愿时光流转，各位能与所念之人重逢。"
                       Margin="0 8 0 0"
                       Classes="l-instructive" FontSize="13"
                       VerticalAlignment="Center" TextAlignment="Center"
                       Background="Transparent"
                       PointerPressed="InputElementReunion_OnPointerPressed"/>
        </StackPanel>
    </controls1:StickyScrollViewer>
</controls:SettingsPageBase>
