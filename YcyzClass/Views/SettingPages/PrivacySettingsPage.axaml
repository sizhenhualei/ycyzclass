<controls:SettingsPageBase x:Class="YcyzClass.Views.SettingPages.PrivacySettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YcyzClass.Views.SettingPages"
      xmlns:controls="clr-namespace:YcyzClass.Core.Abstractions.Controls;assembly=YcyzClass.Core"
      xmlns:controls1="clr-namespace:YcyzClass.Core.Controls;assembly=YcyzClass.Core"
      xmlns:controls2="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:PrivacySettingsPage}">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Tag="CanPolicyDisable">
            <StackPanel Margin="0 0 0 16">
                <TextBlock Text="遥测与数据收集"
                           Theme="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Margin="0 6 0 0" TextWrapping="Wrap"
                           Text="本版本不收集任何遥测数据，也不会上传您的任何信息。" />
                <TextBlock Margin="0 6 0 0" TextWrapping="Wrap">
                    <Run Text="更多信息请见">
                    </Run>
                    <HyperlinkButton Click="HyperlinkMsAppCenter_OnClick">
                        《YcyzClass 隐私政策》
                    </HyperlinkButton>
                    。
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
